# Admin auth
ADMIN_PASSWORD_HASH=scrypt$...
ADMIN_SESSION_SECRET=generate-with-npm-run-admin-secret

# GitHub Contents API (fine-grained PAT, Contents: Read and write, only this repo)
GITHUB_CONTENT_TOKEN=github_pat_...
GITHUB_REPO=your-github-user/anomancer
GITHUB_BRANCH=main

# Anomancer 13.13 · CONTACT GATE
RESEND_API_KEY=
CONTACT_TO_EMAIL=alakhapositu@proton.me
CONTACT_FROM_EMAIL=Anomancer <contact@anomancer.com>

# Canonical public origin used by the static build
PUBLIC_SITE_URL=https://anomancer.com
