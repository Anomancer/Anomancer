{
  "format": "anomancer-mancer-artifact-boundary/v1",
  "id": "codemancer/artifact-boundary/1.0.0",
  "workspaceIsolation": true,
  "store": "mancer/package-artifact-store/v1",
  "read": [
    "workspace-package-artifact",
    "workspace-runs",
    "granted-archive-context"
  ],
  "write": [
    "workspace-package-artifact",
    "local-project-change-set",
    "operation-audit-record"
  ],
  "forbidden": [
    "public-content",
    "other-workspace-artifact",
    "ungranted-archive-context",
    "automatic-release",
    "arbitrary-command-execution",
    "secret-exposure",
    "automatic-production-deploy",
    "release-gate-bypass"
  ],
  "humanApprovalRequired": [
    "apply-code",
    "repository-write-plan",
    "production-deploy",
    "deployment-rollback",
    "archive-approved-artifact",
    "release",
    "local-project-apply"
  ]
}
